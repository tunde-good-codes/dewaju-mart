<!-- apps/notification-service/src/templates/otp.ejs -->
<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; }
        .container { border: 1px solid #eee; padding: 20px; border-radius: 8px; max-width: 500px; }
        .code { font-size: 24px; font-weight: bold; color: #4F46E5; letter-spacing: 2px; }
    </style>
</head>
<body>
    <div class="container">
        <h2>Verify Your Email Address</h2>
        <p>Hello,</p>
        <p>Thank you for signing up at Dewaju Mart. Use the following verification code to complete your registration request. It is valid for 5 minutes:</p>
        <p class="code"><%= otp %></p>
        <p>If you did not request this code, please ignore this message.</p>
    </div>
</body>
</html>