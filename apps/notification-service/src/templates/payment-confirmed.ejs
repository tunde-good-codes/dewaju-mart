<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Payment Confirmed</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: Arial, sans-serif;
      background-color: #f4f6f8;
      padding: 40px 20px;
      color: #1a1a2e;
    }

    .wrapper {
      max-width: 560px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    }

    .header {
      background-color: #16a34a;
      padding: 32px 40px;
      text-align: center;
    }

    .header h1 {
      color: #ffffff;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 0.5px;
    }

    .header p {
      color: #bbf7d0;
      font-size: 13px;
      margin-top: 4px;
    }

    .success-badge {
      text-align: center;
      padding: 28px 40px 0;
    }

    .success-badge .icon {
      width: 64px;
      height: 64px;
      background: #dcfce7;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      margin-bottom: 12px;
    }

    .success-badge h2 {
      font-size: 20px;
      font-weight: 700;
      color: #16a34a;
    }

    .success-badge p {
      font-size: 13px;
      color: #6b7280;
      margin-top: 4px;
    }

    .body {
      padding: 28px 40px 36px;
    }

    .description {
      font-size: 14px;
      color: #4b5563;
      line-height: 1.7;
      margin-bottom: 24px;
    }

    .order-card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 20px 24px;
      margin-bottom: 28px;
    }

    .order-card .label {
      font-size: 11px;
      font-weight: 600;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 4px;
    }

    .order-card .value {
      font-size: 14px;
      font-weight: 600;
      color: #1a1a2e;
      word-break: break-all;
    }

    .order-card .row {
      margin-bottom: 14px;
    }

    .order-card .row:last-child {
      margin-bottom: 0;
    }

    .amount-highlight {
      background: #dcfce7;
      border: 1px solid #86efac;
      border-radius: 10px;
      padding: 18px 24px;
      text-align: center;
      margin-bottom: 28px;
    }

    .amount-highlight .amount-label {
      font-size: 12px;
      color: #16a34a;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 6px;
    }

    .amount-highlight .amount-value {
      font-size: 28px;
      font-weight: 800;
      color: #15803d;
    }

    .amount-highlight .amount-value span {
      font-size: 16px;
      font-weight: 600;
    }

    .next-steps {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 10px;
      padding: 18px 24px;
      margin-bottom: 28px;
    }

    .next-steps h4 {
      font-size: 13px;
      font-weight: 700;
      color: #1d4ed8;
      margin-bottom: 10px;
    }

    .next-steps ul {
      list-style: none;
      padding: 0;
    }

    .next-steps ul li {
      font-size: 13px;
      color: #1d4ed8;
      padding: 3px 0;
    }

    .next-steps ul li::before {
      content: "→ ";
      font-weight: 700;
    }

    .divider {
      border: none;
      border-top: 1px solid #e2e8f0;
      margin-bottom: 24px;
    }

    .footer {
      text-align: center;
      padding: 0 40px 32px;
      font-size: 12px;
      color: #94a3b8;
      line-height: 1.8;
    }

    .footer a {
      color: #16a34a;
      text-decoration: none;
    }
  </style>
</head>
<body>

  <div class="wrapper">

    <!-- Header -->
    <div class="header">
      <h1>Sokomart</h1>
      <p>Payment received — thank you!</p>
    </div>

    <!-- Success badge -->
    <div class="success-badge">
      <div class="icon">✅</div>
      <h2>Payment Confirmed!</h2>
      <p>Your payment was processed successfully</p>
    </div>

    <!-- Body -->
    <div class="body">

      <p class="description" style="margin-top: 20px;">
        Great news! We have received your payment and your order is now being processed.
        You will receive another update once your items are on their way.
      </p>

      <!-- Amount highlight -->
      <div class="amount-highlight">
        <p class="amount-label">Amount Paid</p>
        <p class="amount-value">
          <span>₦</span><%= Number(amount).toLocaleString("en-NG", { minimumFractionDigits: 2 }) %>
        </p>
      </div>

      <!-- Order details card -->
      <div class="order-card">
        <div class="row">
          <p class="label">Order ID</p>
          <p class="value"><%= orderId %></p>
        </div>
        <div class="row">
          <p class="label">Payment Reference</p>
          <p class="value"><%= reference %></p>
        </div>
        <div class="row">
          <p class="label">Status</p>
          <p class="value" style="color: #16a34a;">✓ Successful</p>
        </div>
      </div>

      <!-- Next steps -->
      <div class="next-steps">
        <h4>What happens next?</h4>
        <ul>
          <li>Your order is being prepared by the seller</li>
          <li>You will receive a shipping notification shortly</li>
          <li>Track your order from your Sokomart dashboard</li>
        </ul>
      </div>

      <hr class="divider" />

      <p class="description" style="font-size: 13px; color: #6b7280;">
        If you have any questions about your order, please contact our support team
        with your order ID above and we will be happy to help.
      </p>

    </div>

    <!-- Footer -->
    <div class="footer">
      <p>© <%= new Date().getFullYear() %> Sokomart. All rights reserved.</p>
      <p style="margin-top: 4px;">
        Need help? <a href="mailto:support@sokomart.com">support@sokomart.com</a>
      </p>
    </div>

  </div>

</body>
</html>
```
