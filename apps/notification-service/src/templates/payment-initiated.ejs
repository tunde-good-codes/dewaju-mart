<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Complete Your Payment</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: Arial, sans-serif;
      background-color: #f4f6f8;
      padding: 40px 20px;
      color: #1a1a2e;
    }

    .wrapper {
      max-width: 560px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    }

    .header {
      background-color: #2563EB;
      padding: 32px 40px;
      text-align: center;
    }

    .header h1 {
      color: #ffffff;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 0.5px;
    }

    .header p {
      color: #bfdbfe;
      font-size: 13px;
      margin-top: 4px;
    }

    .body {
      padding: 36px 40px;
    }

    .greeting {
      font-size: 16px;
      color: #1a1a2e;
      margin-bottom: 16px;
    }

    .description {
      font-size: 14px;
      color: #4b5563;
      line-height: 1.7;
      margin-bottom: 28px;
    }

    .order-card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 20px 24px;
      margin-bottom: 28px;
    }

    .order-card .label {
      font-size: 11px;
      font-weight: 600;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 4px;
    }

    .order-card .value {
      font-size: 14px;
      font-weight: 600;
      color: #1a1a2e;
      word-break: break-all;
    }

    .order-card .row {
      margin-bottom: 14px;
    }

    .order-card .row:last-child {
      margin-bottom: 0;
    }

    .cta-wrapper {
      text-align: center;
      margin-bottom: 28px;
    }

    .cta-btn {
      display: inline-block;
      background-color: #2563EB;
      color: #ffffff;
      text-decoration: none;
      padding: 14px 36px;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 600;
      letter-spacing: 0.3px;
    }

    .expiry-note {
      background: #fffbeb;
      border: 1px solid #fde68a;
      border-radius: 8px;
      padding: 12px 16px;
      font-size: 13px;
      color: #92400e;
      margin-bottom: 28px;
      text-align: center;
    }

    .divider {
      border: none;
      border-top: 1px solid #e2e8f0;
      margin-bottom: 24px;
    }

    .footer {
      text-align: center;
      padding: 0 40px 32px;
      font-size: 12px;
      color: #94a3b8;
      line-height: 1.8;
    }

    .footer a {
      color: #2563EB;
      text-decoration: none;
    }
  </style>
</head>
<body>

  <div class="wrapper">

    <!-- Header -->
    <div class="header">
      <h1>Sokomart</h1>
      <p>Your order is waiting for payment</p>
    </div>

    <!-- Body -->
    <div class="body">

      <p class="greeting">Hi there 👋</p>

      <p class="description">
        Your order has been placed successfully on <strong>Sokomart</strong>.
        To confirm your order, please complete your payment using the button below.
        Your items will be reserved until payment is received.
      </p>

      <!-- Order details card -->
      <div class="order-card">
        <div class="row">
          <p class="label">Order ID</p>
          <p class="value"><%= orderId %></p>
        </div>
        <div class="row">
          <p class="label">Payment Reference</p>
          <p class="value"><%= reference %></p>
        </div>
      </div>

      <!-- CTA Button -->
      <div class="cta-wrapper">
        <a href="<%= authorizationUrl %>" class="cta-btn">
          Complete Payment →
        </a>
      </div>

      <!-- Expiry warning -->
      <div class="expiry-note">
        ⏳ This payment link expires in <strong>10 minutes</strong>. Please complete your payment promptly.
      </div>

      <hr class="divider" />

      <p class="description" style="font-size: 13px; color: #6b7280;">
        If you did not place this order or have questions, please ignore this email
        or contact our support team.
      </p>

    </div>

    <!-- Footer -->
    <div class="footer">
      <p>© <%= new Date().getFullYear() %> Sokomart. All rights reserved.</p>
      <p style="margin-top: 4px;">
        Need help? <a href="mailto:support@sokomart.com">support@sokomart.com</a>
      </p>
    </div>

  </div>

</body>
</html>
```
