<!-- apps/notification-service/src/templates/welcome-google.ejs -->
<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; }
        .container { border: 1px solid #eee; padding: 20px; border-radius: 8px; max-width: 500px; text-align: center; }
        .avatar { width: 80px; height: 80px; border-radius: 50%; margin-bottom: 10px; }
    </style>
</head>
<body>
    <div class="container">
        <% if (imageUrl) { %>
            <img class="avatar" src="<%= imageUrl %>" alt="Profile Image" />
        <% } %>
        <h2>Welcome to Dewaju Mart, <%= firstName %>!</h2>
        <p>Your account has been successfully initialized via Google Single Sign-On.</p>
        <p>We are thrilled to have you here. Start exploring your dashboard right away!</p>
    </div>
</body>
</html>